# sample_room.obj
# Watertight 9 x 7 x 3 m room with windows.
# Vertex grid:
#   x : 0, 0.5, 1.5, 7.5, 8.5, 9
#   y : 0 (front), 7 (back)
#   z : 0, 0.8, 2.5, 3
# Vertex numbering: v(ix,iy,iz) = ix*8 + iy*4 + iz + 1  (1-based)

# x = 0
v 0 0 0
v 0 0 0.8
v 0 0 2.5
v 0 0 3
v 0 7 0
v 0 7 0.8
v 0 7 2.5
v 0 7 3
# x = 0.5
v 0.5 0 0
v 0.5 0 0.8
v 0.5 0 2.5
v 0.5 0 3
v 0.5 7 0
v 0.5 7 0.8
v 0.5 7 2.5
v 0.5 7 3
# x = 1.5
v 1.5 0 0
v 1.5 0 0.8
v 1.5 0 2.5
v 1.5 0 3
v 1.5 7 0
v 1.5 7 0.8
v 1.5 7 2.5
v 1.5 7 3
# x = 7.5
v 7.5 0 0
v 7.5 0 0.8
v 7.5 0 2.5
v 7.5 0 3
v 7.5 7 0
v 7.5 7 0.8
v 7.5 7 2.5
v 7.5 7 3
# x = 8.5
v 8.5 0 0
v 8.5 0 0.8
v 8.5 0 2.5
v 8.5 0 3
v 8.5 7 0
v 8.5 7 0.8
v 8.5 7 2.5
v 8.5 7 3
# x = 9
v 9 0 0
v 9 0 0.8
v 9 0 2.5
v 9 0 3
v 9 7 0
v 9 7 0.8
v 9 7 2.5
v 9 7 3

# Floor (z=0), normal -z (outward = downward)
g floor
f 1 5 13 9
f 9 13 21 17
f 17 21 29 25
f 25 29 37 33
f 33 37 45 41

# Ceiling (z=3), normal +z (outward = upward)
g ceiling
f 4 12 16 8
f 12 20 24 16
f 20 28 32 24
f 28 36 40 32
f 36 44 48 40

# Plasterboard surfaces (walls without glass)
g plasterboard
# Left wall (x=0)
f 1 2 6 5
f 2 3 7 6
f 3 4 8 7
# Right wall (x=9)
f 41 45 46 42
f 42 46 47 43
f 43 47 48 44
# Front wall lower row (z=0..0.8, y=0)
f 1 9 10 2
f 9 17 18 10
f 17 25 26 18
f 25 33 34 26
f 33 41 42 34
# Front wall middle row left+right plasterboard strips
f 2 10 11 3
f 34 42 43 35
# Front wall upper row (z=2.5..3, y=0)
f 3 11 12 4
f 11 19 20 12
f 19 27 28 20
f 27 35 36 28
f 35 43 44 36
# Back wall lower row (z=0..0.8, y=7)
f 5 6 14 13
f 13 14 22 21
f 21 22 30 29
f 29 30 38 37
f 37 38 46 45
# Back wall middle row plasterboard strips (x=0..0.5, x=1.5..7.5, x=8.5..9)
f 6 7 15 14
f 22 23 31 30
f 38 39 47 46
# Back wall upper row (z=2.5..3, y=7)
f 7 8 16 15
f 15 16 24 23
f 23 24 32 31
f 31 32 40 39
f 39 40 48 47

# Glass panels
g glass
# Front wall glass (x=0.5..8.5, z=0.8..2.5, y=0)
f 10 18 19 11
f 18 26 27 19
f 26 34 35 27
# Back wall left glass (x=0.5..1.5, z=0.8..2.5, y=7)
f 14 15 23 22
# Back wall right glass (x=7.5..8.5, z=0.8..2.5, y=7)
f 30 31 39 38
